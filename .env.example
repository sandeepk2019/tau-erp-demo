# Tau ERP — environment template
# Copy to .env (local) or let deploy/deploy.sh generate the production one.

# SQLite database (file-based, zero-ops)
DATABASE_URL=file:./db/custom.db

# Public URL of the app (used by NextAuth)
# local:  http://localhost:3000
# prod:   https://erp.yourcompany.com
NEXTAUTH_URL=http://localhost:3000

# Generate:  openssl rand -base64 32
NEXTAUTH_SECRET=replace-me
