# ============================================================================
# Tau ERP — production environment template
# Copy to /opt/tau-erp/.env and fill in (deploy.sh does this automatically).
# NEVER commit the real .env to git.
# ============================================================================

# SQLite database file (single-file DB — back this up!)
DATABASE_URL=file:/opt/tau-erp/db/custom.db

# Public URL of the deployment (must match how users reach the app)
# With domain:  NEXTAUTH_URL=https://erp.yourcompany.com
# Without:      NEXTAUTH_URL=http://203.0.113.10
NEXTAUTH_URL=https://erp.yourcompany.com

# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32

NODE_ENV=production
